# Discord application bot token, invited into the community server and every unit's server.
DISCORD_TOKEN=

# Base URL of the forumify instance (no trailing slash).
FORUMIFY_BASE_URL=https://your-forumify-instance.example.com

# OAuth client credentials this bot exchanges for a short-lived access token when calling
# forumify's Discord API endpoints. Found on the plugin's admin settings page (Admin ->
# Discord Plugin Settings) - forumify auto-creates this OAuth client the first time that
# page loads with the bot not yet registered.
FORUMIFY_CLIENT_ID=
FORUMIFY_CLIENT_SECRET=

# Public URL forumify should use to reach this bot's HTTP API (sent during self-registration).
BOT_PUBLIC_URL=https://bot.your-domain.example.com

# Bearer token forumify must send when calling this bot's HTTP API. Also used as the
# token handed to forumify during self-registration, so forumify learns it from us.
BOT_SHARED_SECRET=change-me

# Port this bot's HTTP API listens on.
BOT_PORT=4100
